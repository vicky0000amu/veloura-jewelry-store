# ─── Lumière Jewels Backend — Environment Variables ───
# Copy this file, rename it to .env, and fill in your values.
# NEVER share this file or upload it to GitHub!

# Server port (5000 is the default, don't change unless needed)
PORT=5000

# Secret key for admin login tokens — make this a long random string!
# Example: lumiere-jewels-super-secret-key-2024-xkj28fns
JWT_SECRET=MyVelouraSecretKey2026XYZ

# ─── EMAIL SETTINGS (optional — for order confirmation emails) ───
# If you skip this, orders still work — emails just won't be sent.
# Use Gmail App Password: https://support.google.com/accounts/answer/185833

EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=Lumière Jewels <youremail@gmail.com>
